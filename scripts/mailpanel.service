[Unit]
Description=MailPanel - iRedMail Web Admin
After=network.target mariadb.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mailpanel/backend
Environment=PYTHONPATH=/opt/mailpanel/backend
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
