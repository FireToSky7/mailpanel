[Unit]
Description=MailPanel - iRedMail Web Admin
After=network.target mariadb.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mailpanel/backend
Environment=PYTHONPATH=/opt/mailpanel/backend
ExecStart=/opt/mailpanel/scripts/run-mailpanel.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
